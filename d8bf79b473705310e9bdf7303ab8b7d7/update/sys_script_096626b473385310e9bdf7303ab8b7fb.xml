        <script><![CDATA[(function executeRule(current, previous) {
    if (!current.getValue('cmdb_ci')) return;

    var util = new OrphanedCIRemediationUtil();
    var response = util.retireCIViaIRE(current.getValue('cmdb_ci'));
    var item = (response && response.items && response.items.length > 0) ? response.items[0] : null;
    var hasErrors = !item || (item.errors && item.errors.length > 0);

    if (!hasErrors) {
        gs.addInfoMessage('CI successfully retired via IRE (' + item.operation + ').');
    } else {
        gs.addErrorMessage('IRE blocked or errored on CI retirement. Check System Logs for details.');
    }
})(current, previous);]]></script>
